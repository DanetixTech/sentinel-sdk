{
  "name": "@danetix/sentinel",
  "version": "1.0.3",
  "description": "Danetix device intelligence SDK",
  "license": "UNLICENSED",
  "author": "Danetix (https://danetix.com)",
  "type": "module",
  "main": "./dist/stl.cjs.min.js",
  "module": "./dist/stl.esm.min.js",
  "exports": {
    ".": {
      "import": "./dist/stl.esm.min.js",
      "require": "./dist/stl.cjs.min.js",
      "default": "./dist/stl.umd.min.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "danetix",
    "device intelligence",
    "analytics"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:production": "NODE_ENV=production rollup -c",
    "dev": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "prepublishOnly": "NODE_ENV=production rollup -c",
    "version": "pnpm run build:production"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "^3.1.3",
    "happy-dom": "^17.4.4",
    "javascript-obfuscator": "^5.3.0",
    "rollup": "^4.34.8",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "ua-parser-js": "^2.0.9",
    "vitest": "^3.1.3"
  }
}
